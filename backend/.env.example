# Supabase (server-side only — never commit real values)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional direct Postgres connection for psql / migrations
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# LLM
OPENAI_API_KEY=
VECTERRA_VISION_MODEL=gpt-4o

# API — the server refuses to start with an empty/placeholder token unless VECTERRA_ENV=dev
VECTERRA_ENV=dev
VECTERRA_API_TOKEN=
