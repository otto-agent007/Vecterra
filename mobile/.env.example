# Public (anon) credentials only — RLS protects the data. Never put the service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# DEV ONLY. Lets the app sign in anonymously so RLS policies apply without an account.
# Ignored in release builds. Keep "Anonymous sign-ins" OFF in Supabase for production.
EXPO_PUBLIC_ALLOW_ANON_AUTH=false
